---
const {
  title,
  description,
  image,
  alt,
  buttonText,
  buttonLink
} = Astro.props;
---

<div class="card">
  <img src={image} alt={alt} class="card-image" />

  <div class="card-content">
    <h3>{title}</h3>

    <p>{description}</p>

    <a href={buttonLink} class="button">
      {buttonText}
    </a>
  </div>
</div>

<style>
  .card {
    background: rgba(255, 255, 255, 0.17);
  backdrop-filter: blur(5.1px) saturate(100%) brightness(100%);
  -webkit-backdrop-filter: blur(5.1px) saturate(100%) brightness(100%);
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.38);
  box-shadow: 0px 4px 30px 0px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    width: 100%;
    display: flex;
    flex-direction: column;
    transition: 0.3s ease;
  }


  .card-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-fit: cover;
  object-position: top;
  }

  .card-content {
    padding: 1.5rem;
    position: relative;
  }

  h3 {
    margin-bottom: 1rem;
    font-size: 1.4rem;
    color: wheat;
  }

  p {
    margin-bottom: 1.5rem;
    line-height: 1.6;
    text-shadow: none;
    font-size: .8rem;
    width: 100%;
  }

  .card-content .button {
    margin-top: auto;
    text-decoration: none;
    border-radius: 8px;
  }
  @media (min-width:600px) {
    .card:nth-child(odd){
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
    }
    .card:nth-child(even){
        display: flex;
        flex-direction: row-reverse;
        flex-wrap: nowrap;
    }
    .card{
        width: 100%;
        max-width: none;
    }
    .card img{
        width: 30%;
    }
    .card .card-content{
        width: 70%;
    }
  }
  @media (min-width: 1200px) {
    .card:nth-child(odd){
        flex-wrap: wrap;
        flex: 1;
        width: 30%;
        max-width: 400px;
        align-items: flex-start;
        justify-content: flex-start;
    }
    .card:nth-child(even){
        flex-wrap: wrap;
        flex: 1;
        width: 30%;
        max-width: 400px;
        align-items: flex-start;
        justify-content: flex-start;
    }
    .card img{
        width: 100%;
        height: 40%;
    }
    .card-content{
        width: 100%;
        min-width: 260px;
        margin-right: auto;
        margin-top: auto;
        padding: 1rem;
    }
  }
</style>