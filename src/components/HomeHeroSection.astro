---
import HeadingAnimation from "./HeadingAnimation.astro"
---

<section class="hero-section">
        <h1>Reliable</h1>
        <HeadingAnimation/> 
        <h1>Services Provider in PNG</h1>

        <p>
            Raballam Maintenance Ltd delivers professional Maintenance, Cleaning, Pest Control and Fumigation services for residential, commercial, and industrial clients.
        </p>
        <div class="cta-container">
            <a href="" class="button">Request Quote</a>
            <a href="" class="button">Contact Us</a>
        </div>
</section>
<style>
    
.hero-section{
    width: 100vw;
    height: 70vh;
    background-image: url(/h1.jpg);
    background-position: top left;
    background-size: cover;
    background-repeat: no-repeat;
    display: flex;
    box-shadow: 1px 1px 5px black;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem;
}
.hero-section > *{
    width: 35%;
    margin-bottom: 1rem;
}
.hero-section .cta-container{
    margin-top: 1rem;
    display: flex;
    flex-wrap: nowrap;
    gap: .5rem;
}
.hero-section img{
    height: fit-content;
}
@media (max-width: 880px) {
    .hero-section {
        background-image: url(/h2.jpg);
        background-position: top left;
        justify-content: flex-start;
        padding: 7rem 2rem 0 2rem;
    }
    .hero-section > *{
        width: 100%;
        max-width: 290px;
        margin: 0%;
    }
}
@media (max-width: 500px) {
    .hero-section{
        padding: 7rem 1rem 0 1rem;
    }
    .hero-section p{
        margin-top: 1rem;
    }
}
</style>