---
import HeadingAnimation from "./HeadingAnimation.astro"
---

<section class="hero-section">
        <h1>Reliable</h1>
        <HeadingAnimation/> 
        <h1>Services Provider in Papua New Guinea</h1>

        <p>
            Raballam Maintenance Ltd delivers professional plumbing, electrical, air conditioning, and general maintenance solutions for residential, commercial, and industrial clients.
        </p>
        <div class="cta-container">
            <a href="" class="button">Request Quote</a>
            <a href="" class="button">Contact Us</a>
        </div>
    </section>
    <section class="val-proposition">
        <h2>
            Trusted. Responsive. Professional.
        </h2>
        <p>
            We provide dependable maintenance services tailored to your needs. Whether it’s urgent repairs or scheduled maintenance, our team ensures quality workmanship, timely delivery, and long-lasting solutions.
        </p>
</section>
<style>
    
.hero-section{
    width: 100%;
    height: 90vh;
    background-image: url(/h1.jpg);
    background-position: top left;
    background-size: cover;
    background-repeat: no-repeat;
    display: flex;
    box-shadow: 2px 2px 5px black;
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.hero-section > *{
    width: 35%;
    margin-left: 4rem;
    margin-bottom: 1rem;
}
.hero-section .cta-container{
    margin-top: 1rem;
    display: flex;
    flex-wrap: nowrap;
    gap: .5rem;
}
.hero-section img{
    height: fit-content;
}
@media (max-width: 880px) {
    .hero-section {
        background-image: url(/h2.jpg);
        background-position: top;
        justify-content: flex-start;
        padding: 7rem 2rem 0 2rem;
        height: 80vh;
    }
    .hero-section > *{
        width: fit-content;
        margin: 0%;
    }
}
@media (max-width: 500px) {
    .hero-section{
        padding: 7rem 1rem 0 1rem;
    }
}
</style>